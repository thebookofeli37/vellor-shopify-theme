{% comment %}
  VELLOR — Hero Image Slideshow
  Full-screen crossfade slideshow with Project V campaign images.
  Auto-advances every 5 seconds. No controls visible — just immersive imagery.
{% endcomment %}

<section id="hero-slideshow-{{ section.id }}" class="vellor-slides">
  <div class="vellor-slides__track">
    <div class="vellor-slides__slide is-active">
      <img src="{{ 'projectv-hf-hoodies-vellor-hoodie-dual-v-back-london-rolls-royce.jpg' | asset_url }}" alt="VELLOR — London" loading="eager">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'project-v-v-perfecto-front.png' | asset_url }}" alt="VELLOR — The V Perfecto" loading="lazy">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'projectv-hf-hoodies-vellor-hoodie-lined-v-back-miami-nightlife.jpg' | asset_url }}" alt="VELLOR — Miami Nightlife" loading="lazy">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'project-v-v-leather-pant-wide.png' | asset_url }}" alt="VELLOR — The V Leather Pant" loading="lazy">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'projectv-hf-campaign-vellor-crew-hoodies-warehouse-party.jpg' | asset_url }}" alt="VELLOR — Warehouse" loading="lazy">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'project-v-v040.png' | asset_url }}" alt="VELLOR — Varsity Jacket" loading="lazy">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'projectv-hf-outerwear-vellor-bomber-jacket-deco-v-back-penthouse.jpg' | asset_url }}" alt="VELLOR — Deco Bomber" loading="lazy">
    </div>
    <div class="vellor-slides__slide">
      <img src="{{ 'project-v-bag-v051.png' | asset_url }}" alt="VELLOR — V-Capucine Bag" loading="lazy">
    </div>
  </div>

  <div class="vellor-slides__overlay"></div>

  <div class="vellor-slides__content">
    <p class="vellor-slides__label">Project V</p>
    <h1 class="vellor-slides__heading">VELLOR</h1>
    <p class="vellor-slides__sub">Designer streetwear. Maison-tier construction.</p>
    <a href="/pages/project-v" class="vellor-slides__cta">Explore Project V</a>
  </div>

  <!-- Progress dots -->
  <div class="vellor-slides__dots">
    <span class="vellor-slides__dot is-active"></span>
    <span class="vellor-slides__dot"></span>
    <span class="vellor-slides__dot"></span>
    <span class="vellor-slides__dot"></span>
    <span class="vellor-slides__dot"></span>
    <span class="vellor-slides__dot"></span>
    <span class="vellor-slides__dot"></span>
    <span class="vellor-slides__dot"></span>
  </div>
</section>

<style>
  .vellor-slides {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    background: #0A0A0A;
  }

  .vellor-slides__track {
    position: absolute;
    inset: 0;
  }

  .vellor-slides__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .vellor-slides__slide.is-active {
    opacity: 1;
  }

  .vellor-slides__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .vellor-slides__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.1) 60%,
      rgba(0, 0, 0, 0.55) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .vellor-slides__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 2rem;
  }

  .vellor-slides__label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.5);
    margin: 0 0 20px;
  }

  .vellor-slides__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 10vw, 11rem);
    font-weight: 300;
    letter-spacing: 0.25em;
    color: #F2F2F2;
    margin: 0;
    text-transform: uppercase;
    line-height: 1;
  }

  .vellor-slides__sub {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: rgba(242, 242, 242, 0.6);
    margin: 20px 0 0;
  }

  .vellor-slides__cta {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 40px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #F2F2F2;
    border: 1px solid rgba(242, 242, 242, 0.4);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .vellor-slides__cta:hover {
    background: #F2F2F2;
    color: #0A0A0A;
    border-color: #F2F2F2;
    opacity: 1;
  }

  .vellor-slides__dots {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 10px;
  }

  .vellor-slides__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(242, 242, 242, 0.3);
    transition: background 0.3s ease, transform 0.3s ease;
    cursor: pointer;
  }

  .vellor-slides__dot.is-active {
    background: #F2F2F2;
    transform: scale(1.3);
  }
</style>

<script>
  (function() {
    var section = document.getElementById('hero-slideshow-{{ section.id }}');
    if (!section) return;

    var slides = section.querySelectorAll('.vellor-slides__slide');
    var dots = section.querySelectorAll('.vellor-slides__dot');
    var current = 0;
    var total = slides.length;
    var interval = 5000;
    var timer;

    function goTo(index) {
      slides[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');
      current = index % total;
      slides[current].classList.add('is-active');
      dots[current].classList.add('is-active');
    }

    function next() {
      goTo(current + 1);
    }

    function startAuto() {
      timer = setInterval(next, interval);
    }

    // Dot clicks
    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        clearInterval(timer);
        goTo(i);
        startAuto();
      });
    });

    // Pause on hover
    section.addEventListener('mouseenter', function() { clearInterval(timer); });
    section.addEventListener('mouseleave', startAuto);

    startAuto();
  })();
</script>

{% schema %}
{
  "name": "Hero Slideshow",
  "tag": "section",
  "class": "vellor-section-slideshow",
  "settings": [],
  "presets": [
    {
      "name": "Hero Slideshow",
      "category": "VELLOR"
    }
  ]
}
{% endschema %}
