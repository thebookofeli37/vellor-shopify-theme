{% comment %}
  VELLOR — Project V Lookbook
  Designer streetwear capsule. Maison-tier construction, Miami-coded street energy.
  50 pieces (33 women's / 17 men's) + 12 signature bags.
{% endcomment %}

<style>
  .pv {
    background: #0A0A0A;
    color: #F2F2F2;
    overflow-x: hidden;
  }

  /* Hero */
  .pv__hero {
    height: 100vh;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    background: #050505;
    overflow: hidden;
  }

  .pv__hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at center, rgba(242,242,242,0.03) 0%, transparent 70%);
  }

  .pv__hero-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(242,242,242,0.4);
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .pv__hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F2F2F2;
    margin: 0;
    line-height: 0.9;
    position: relative;
    z-index: 1;
  }

  .pv__hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: rgba(242,242,242,0.5);
    margin-top: 32px;
    max-width: 480px;
    line-height: 1.8;
    position: relative;
    z-index: 1;
  }

  .pv__hero-detail {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(242,242,242,0.2);
    margin-top: 48px;
    position: relative;
    z-index: 1;
  }

  /* Section headers */
  .pv__section-header {
    text-align: center;
    padding: 100px 40px 60px;
  }

  .pv__section-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(242,242,242,0.3);
    margin-bottom: 16px;
  }

  .pv__section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    color: #F2F2F2;
    margin: 0;
    letter-spacing: 0.05em;
  }

  .pv__section-count {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: rgba(242,242,242,0.25);
    margin-top: 12px;
    letter-spacing: 0.1em;
  }

  /* Grid */
  .pv__grid {
    display: grid;
    gap: 4px;
    padding: 0 4px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .pv__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .pv__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .pv__grid--4 { grid-template-columns: repeat(4, 1fr); }

  .pv__grid-item {
    position: relative;
    overflow: hidden;
    background: #111;
    aspect-ratio: 3/4;
  }

  .pv__grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .pv__grid-item:hover img {
    transform: scale(1.03);
  }

  .pv__grid-item-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .pv__grid-item:hover .pv__grid-item-info {
    opacity: 1;
  }

  .pv__grid-item-code {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(242,242,242,0.6);
  }

  .pv__grid-item-name {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #F2F2F2;
    margin-top: 4px;
    letter-spacing: 0.02em;
  }

  /* Hero piece — full width */
  .pv__hero-piece {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    margin: 4px;
  }

  .pv__hero-piece-image {
    overflow: hidden;
    background: #111;
  }

  .pv__hero-piece-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pv__hero-piece-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 80px;
    background: #0A0A0A;
  }

  .pv__hero-piece-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(242,242,242,0.3);
    margin-bottom: 16px;
  }

  .pv__hero-piece-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    color: #F2F2F2;
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }

  .pv__hero-piece-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgba(242,242,242,0.5);
    line-height: 1.8;
    max-width: 400px;
  }

  .pv__hero-piece-price {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #F2F2F2;
    margin-top: 24px;
    letter-spacing: 0.05em;
  }

  /* Divider */
  .pv__divider {
    width: 40px;
    height: 1px;
    background: rgba(242,242,242,0.15);
    margin: 80px auto;
  }

  /* Footer CTA */
  .pv__cta {
    text-align: center;
    padding: 120px 40px;
    background: #050505;
  }

  .pv__cta-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 300;
    color: #F2F2F2;
    margin: 0 0 16px;
  }

  .pv__cta-text {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: rgba(242,242,242,0.5);
    margin-bottom: 32px;
  }

  .pv__cta-btn {
    display: inline-block;
    padding: 16px 48px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0A0A0A;
    background: #F2F2F2;
    border: 1px solid #F2F2F2;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .pv__cta-btn:hover {
    background: transparent;
    color: #F2F2F2;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pv__grid--3 { grid-template-columns: repeat(2, 1fr); }
    .pv__grid--4 { grid-template-columns: repeat(2, 1fr); }
    .pv__hero-piece { grid-template-columns: 1fr; }
    .pv__hero-piece-info { padding: 40px 24px; }
    .pv__section-header { padding: 60px 20px 40px; }
  }

  @media (max-width: 480px) {
    .pv__grid--3 { grid-template-columns: 1fr; }
  }
</style>

<section class="pv">

  <!-- ============================================================
       HERO
       ============================================================ -->
  <div class="pv__hero">
    <p class="pv__hero-label">Designer Streetwear Capsule</p>
    <h1 class="pv__hero-title">Project V</h1>
    <p class="pv__hero-sub">Maison-tier construction. Miami-coded street energy. 50 pieces. Leather goods integrated throughout. Lot codes V001&ndash;V050.</p>
    <p class="pv__hero-detail">33 Women&rsquo;s &middot; 17 Men&rsquo;s &middot; 12 Signature Bags</p>
  </div>

  <!-- ============================================================
       HERO PIECES — THE V PERFECTO + THE V LEATHER PANT
       ============================================================ -->
  <div class="pv__hero-piece">
    <div class="pv__hero-piece-image">
      <img src="{{ 'project-v-v-perfecto-front.png' | asset_url }}" alt="The V Perfecto" loading="lazy">
    </div>
    <div class="pv__hero-piece-info">
      <p class="pv__hero-piece-label">Signature Piece</p>
      <h2 class="pv__hero-piece-title">The V Perfecto</h2>
      <p class="pv__hero-piece-desc">Cropped biker jacket in butter-soft black Italian Nappa leather. Asymmetric zip, lacquered brass hardware, Crowned V embroidered on chest. Hand-stitched edges.</p>
      <p class="pv__hero-piece-price">$2,495</p>
    </div>
  </div>

  <div class="pv__hero-piece" style="direction: rtl;">
    <div class="pv__hero-piece-info" style="direction: ltr;">
      <p class="pv__hero-piece-label">Signature Piece</p>
