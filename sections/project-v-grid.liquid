<style>
  .pvg { background: #0A0A0A; }

  .pvg__header { text-align: center; padding: 100px 40px 60px; }

  .pvg__label {
    font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 400;
    letter-spacing: 0.3em; text-transform: uppercase; color: rgba(242,242,242,0.35); margin: 0 0 16px;
  }

  .pvg__title {
    font-family: 'Cormorant Garamond', serif; font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 300; color: #F2F2F2; margin: 0; letter-spacing: 0.1em;
  }

  .pvg__sub {
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 300;
    color: rgba(242,242,242,0.45); margin: 16px 0 0;
  }

  .pvg__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 0 2px;
    max-width: 1600px; margin: 0 auto;
  }

  .pvg__item { position: relative; background: #111; }

  .pvg__image { aspect-ratio: 3/4; overflow: hidden; }

  .pvg__image img {
    width: 100%; height: 100%; object-fit: cover; object-position: center center;
    transition: transform 0.6s ease;
  }

  .pvg__item:hover .pvg__image img { transform: scale(1.05); }

  /* 3D card effects */
  .pvg__item {
    perspective: 800px; transform-style: preserve-3d;
    opacity: 0; transform: translateY(50px) rotateX(8deg);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .pvg__item.is-visible { opacity: 1; transform: translateY(0) rotateX(0); }
  .pvg__item:nth-child(2) { transition-delay: 0.08s; }
  .pvg__item:nth-child(3) { transition-delay: 0.16s; }
  .pvg__item:nth-child(4) { transition-delay: 0.24s; }
  .pvg__item:nth-child(5) { transition-delay: 0.08s; }
  .pvg__item:nth-child(6) { transition-delay: 0.16s; }
  .pvg__item:nth-child(7) { transition-delay: 0.24s; }
  .pvg__item:nth-child(8) { transition-delay: 0.08s; }
  .pvg__item:nth-child(9) { transition-delay: 0.16s; }
  .pvg__item:nth-child(10) { transition-delay: 0.24s; }
  .pvg__item:nth-child(11) { transition-delay: 0.08s; }
  .pvg__item:nth-child(12) { transition-delay: 0.16s; }

  .pvg__item:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(242,242,242,0.06);
  }

  .pvg__info { padding: 16px 16px 20px; background: #0A0A0A; }

  .pvg__name {
    font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 400;
    color: #F2F2F2; margin: 0; letter-spacing: 0.03em;
  }

  .pvg__stock {
    font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 400;
    letter-spacing: 0.15em; text-transform: uppercase; color: rgba(242,242,242,0.3); margin: 8px 0 0;
  }

  .pvg__cta-row { text-align: center; padding: 48px 40px; }

  .pvg__view-all {
    font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 400;
    letter-spacing: 0.15em; text-transform: uppercase; color: #F2F2F2; text-decoration: none;
    border-bottom: 1px solid rgba(242,242,242,0.3); padding-bottom: 4px; transition: border-color 0.3s ease;
  }

  .pvg__view-all:hover { border-color: #F2F2F2; opacity: 1; }

  .pvg__signup { border-top: 1px solid rgba(242,242,242,0.1); padding: 80px 40px; }

  .pvg__signup-inner { max-width: 500px; margin: 0 auto; text-align: center; }

  .pvg__signup-heading {
    font-family: 'Cormorant Garamond', serif; font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300; color: #F2F2F2; margin: 0 0 12px;
  }

  .pvg__signup-text {
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 300;
    color: rgba(242,242,242,0.45); margin: 0 0 28px; line-height: 1.7;
  }

  .pvg__signup-form { display: flex; gap: 0; }

  .pvg__signup-input {
    flex: 1; padding: 14px 18px; background: transparent;
    border: 1px solid rgba(242,242,242,0.2); border-right: none; color: #F2F2F2;
    font-family: 'Inter', sans-serif; font-size: 12px; letter-spacing: 0.04em; outline: none;
  }

  .pvg__signup-input::placeholder { color: rgba(242,242,242,0.35); }
  .pvg__signup-input:focus { border-color: rgba(242,242,242,0.5); }

  .pvg__signup-btn {
    padding: 14px 28px; background: #F2F2F2; color: #0A0A0A;
    border: 1px solid #F2F2F2; font-family: 'Inter', sans-serif; font-size: 11px;
    font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pvg__signup-btn:hover { background: transparent; color: #F2F2F2; }

  @media (max-width: 768px) {
    .pvg__grid { grid-template-columns: repeat(2, 1fr); }
    .pvg__header { padding: 60px 20px 40px; }
    .pvg__signup { padding: 60px 20px; }
    .pvg__signup-form { flex-direction: column; }
    .pvg__signup-input { border-right: 1px solid rgba(242,242,242,0.2); border-bottom: none; }
    .pvg__signup-btn { width: 100%; }
  }

  @media (max-width: 480px) { .pvg__grid { grid-template-columns: 1fr; } }
</style>

<script>
(function(){
  // Scroll-driven reveal for product grid items
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) entry.target.classList.add('is-visible');
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.pvg__item').forEach(function(item) { observer.observe(item); });

  // 3D tilt on hover
  document.querySelectorAll('.pvg__item').forEach(function(card) {
    card.addEventListener('mousemove', function(e) {
      var rect = card.getBoundingClientRect();
      var x = (e.clientX - rect.left) / rect.width;
      var y = (e.clientY - rect.top) / rect.height;
      var tiltX = (y - 0.5) * 8;
      var tiltY = (x - 0.5) * -8;
      card.style.transform = 'translateY(-6px) rotateX(' + tiltX + 'deg) rotateY(' + tiltY + 'deg)';
    });
    card.addEventListener('mouseleave', function() {
      card.style.transform = '';
    });
  });
})();
</script>

