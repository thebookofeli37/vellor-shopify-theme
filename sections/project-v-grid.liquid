      {%- form 'customer', id: 'project-v-signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,project-v,early-access">
        <div class="pvg__signup-form">
          <input
            class="pvg__signup-input"
            type="email"
            name="contact[email]"
            placeholder="Enter your email"
            required
            autocomplete="email"
            aria-label="Email for Project V early access"
          >
          <button type="submit" class="pvg__signup-btn">Get Notified</button>
